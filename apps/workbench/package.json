{
  "name": "codech-workbench",
  "displayName": "Codech IDE — Workbench",
  "version": "0.3.0",
  "publisher": "codech",
  "description": "Agent-first workbench with central chat, local Markdown knowledge, worktrees and human code review.",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Agent execution and workspace operations require Workspace Trust."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "codech.open",
        "title": "Codech: Open Workbench"
      },
      {
        "command": "codech.knowledge",
        "title": "Codech: Open Knowledge"
      },
      {
        "command": "codech.review",
        "title": "Codech: Review Changes"
      },
      {
        "command": "codech.worktrees",
        "title": "Codech: Open Worktrees"
      },
      {
        "command": "codech.graph",
        "title": "Codech: Open Graph"
      },
      {
        "command": "codech.newChat",
        "title": "Codech: New Chat"
      },
      {
        "command": "codech.setApiKey",
        "title": "Codech: Set OpenAI API Key"
      },
      {
        "command": "codech.login",
        "title": "Codech: Sign In with ChatGPT"
      },
      {
        "command": "codech.appearance",
        "title": "Codech: Change Color Theme"
      },
      {
        "command": "codech.settings",
        "title": "Codech: Agent Budget Settings"
      },
      {
        "command": "codech.focusInput",
        "title": "Codech: Focus AI Composer"
      },
      {
        "command": "codech.browser",
        "title": "Codech: Open Browser / Search Web"
      },
      {
        "command": "codech.inspect",
        "title": "Codech: Inspect Browser Element"
      },
      {
        "command": "codech.addSource",
        "title": "Codech: Add Source / Knowledge Vault"
      },
      {
        "command": "codech.pet",
        "title": "Codech: Toggle Codechi Companion"
      },
      {
        "command": "codech.voice",
        "title": "Codech: Offline Persian Dictation"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codech-chats",
          "title": "Codech Chats",
          "icon": "media/chat.svg"
        },
        {
          "id": "codech-knowledgeContainer",
          "title": "Knowledge",
          "icon": "media/book.svg"
        },
        {
          "id": "codech-reviewContainer",
          "title": "Code Review",
          "icon": "media/review.svg"
        }
      ],
      "panel": [
        {
          "id": "codech-agent",
          "title": "Codech",
          "icon": "media/chat.svg"
        }
      ]
    },
    "views": {
      "codech-chats": [
        {
          "id": "codech.sessions",
          "name": "Conversations"
        }
      ],
      "codech-knowledgeContainer": [
        {
          "id": "codech.notes",
          "name": "Knowledge Vault"
        }
      ],
      "codech-reviewContainer": [
        {
          "id": "codech.changes",
          "name": "Review & Worktrees"
        }
      ],
      "codech-agent": [
        {
          "id": "codech.composer",
          "name": "Ask Codech",
          "type": "webview"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codech.focusInput",
        "key": "ctrl+alt+space",
        "mac": "cmd+alt+space"
      },
      {
        "command": "codech.newChat",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "codech.browser",
        "key": "ctrl+alt+b"
      },
      {
        "command": "codech.inspect",
        "key": "ctrl+alt+i"
      },
      {
        "command": "codech.voice",
        "key": "ctrl+alt+v"
      }
    ],
    "themes": [
      {
        "label": "Codech Graphite",
        "uiTheme": "vs-dark",
        "path": "./themes/graphite.json"
      },
      {
        "label": "Codech Paper",
        "uiTheme": "vs",
        "path": "./themes/paper.json"
      },
      {
        "label": "Codech Forest",
        "uiTheme": "vs-dark",
        "path": "./themes/forest.json"
      }
    ],
    "configuration": {
      "title": "Codech IDE",
      "properties": {
        "codech.codexPath": {
          "type": "string",
          "default": "",
          "description": "Leave empty to use the bundled Codex runtime, then PATH as fallback. Custom executable is optional."
        },
        "codech.defaultProvider": {
          "type": "string",
          "enum": [
            "codex",
            "api"
          ],
          "default": "codex"
        },
        "codech.model": {
          "type": "string",
          "default": "gpt-6.1-terra",
          "description": "Requested model; availability depends on provider/account."
        },
        "codech.contextChars": {
          "type": "number",
          "default": 12000,
          "minimum": 4000,
          "maximum": 80000
        },
        "codech.apiMaxSteps": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 20
        },
        "codech.graphitiUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000/mcp/",
          "description": "Optional local Graphiti Streamable HTTP MCP endpoint. Start the service separately."
        },
        "codech.apiMaxOutputTokens": {
          "type": "number",
          "default": 3000,
          "minimum": 512,
          "maximum": 12000,
          "description": "Maximum output tokens per API response, including reasoning."
        },
        "codech.apiUsageGuard": {
          "type": "number",
          "default": 16000,
          "minimum": 2000,
          "maximum": 100000,
          "description": "Soft per-turn API token guard. Evaluated after each response; it is not a hard dollar limit."
        },
        "codech.toolOutputChars": {
          "type": "number",
          "default": 12000,
          "minimum": 1000,
          "maximum": 40000,
          "description": "Maximum characters returned by one API tool."
        },
        "codech.apiHistoryTurns": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 20,
          "description": "Renew the API response chain after this many completed turns, replaying at most four recent messages and fresh project context. Older conversation history is omitted."
        },
        "codech.openOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Open the persistent Codech input panel on startup."
        },
        "codech.petEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the animated Codechi companion in the input panel."
        },
        "codech.searchEngine": {
          "type": "string",
          "enum": [
            "duckduckgo",
            "google",
            "bing"
          ],
          "default": "duckduckgo",
          "description": "Search provider opened inside the integrated browser."
        },
        "codech.voiceThreads": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 16,
          "description": "CPU threads for offline Whisper dictation."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AmirMohammadDehghan/codech-ide.git"
  },
  "enabledApiProposals": [
    "browser"
  ]
}
